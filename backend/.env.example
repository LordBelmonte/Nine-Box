# ================================================================
# .env.example — Copie para .env e preencha os valores
# ================================================================

PORT=3000
NODE_ENV=development

# Banco de dados
# Local:      postgresql://postgres:senha@localhost:5432/ninebox
# Supabase:   postgresql://postgres:SENHA@db.PROJETO.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:senha@localhost:5432/ninebox"
DIRECT_URL="postgresql://postgres:senha@localhost:5432/ninebox"

# JWT
# OBRIGATÓRIO em produção: gere um secret seguro
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="TROQUE_POR_UM_SECRET_SEGURO"
JWT_EXPIRES_IN=30d

# ================================================================
# CORS — Preencha no painel do Render em produção
# ================================================================

# FRONTEND_URL: URL pública do frontend (ou do próprio backend se servir o frontend)
# Exemplo: https://ninebox-backend.onrender.com
FRONTEND_URL=

# BACKEND_URL: URL pública deste backend (usada no CSP do Helmet)
# Exemplo: https://ninebox-backend.onrender.com
BACKEND_URL=

# CORS_ORIGINS: URLs extras separadas por vírgula (opcional)
# Use se o frontend estiver em outro domínio (Vercel, etc.)
# Exemplo: https://meu-frontend.vercel.app,https://preview.vercel.app
CORS_ORIGINS=
