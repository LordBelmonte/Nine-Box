PORT=3000

# Banco de dados (local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ninebox"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ninebox"

# JWT — TROQUE por uma string longa e aleatória em produção!
# Exemplo: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="TROQUE_POR_UM_SECRET_SEGURO_EM_PRODUCAO"
JWT_EXPIRES_IN=30d

NODE_ENV=development

# =============================================
# CORS — Origens permitidas
# =============================================

# URL principal do frontend.
# Desenvolvimento local com live-server:
#   FRONTEND_URL=http://localhost:5500
# Deploy separado (frontend no Vercel):
#   FRONTEND_URL=https://meu-app.vercel.app
FRONTEND_URL=http://localhost:5500

# URLs adicionais separadas por vírgula (opcional).
# Útil para preview deploys ou múltiplos domínios.
# Exemplo:
#   CORS_ORIGINS=https://preview.meu-app.vercel.app,https://staging.meu-app.com
CORS_ORIGINS=

# URL pública do próprio backend (usado no Content-Security-Policy do Helmet).
# Deixe vazio em desenvolvimento local.
# Exemplo em produção: BACKEND_URL=https://meu-backend.onrender.com
BACKEND_URL=
